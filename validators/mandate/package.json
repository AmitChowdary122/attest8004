{
  "name": "@attest8004/validator-mandate",
  "version": "0.0.0",
  "private": true,
  "description": "mandate-v1: deterministic, re-executable Attest8004 validator",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@attest8004/source": "./src/index.ts"
    }
  },
  "scripts": {
    "start": "node --conditions=@attest8004/source --env-file=../../.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "evaluate": "node --conditions=@attest8004/source --env-file-if-exists=../../.env src/evaluate-main.ts"
  },
  "dependencies": {
    "@attest8004/sdk": "workspace:*",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
