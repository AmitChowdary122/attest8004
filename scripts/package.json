{
  "name": "@attest8004/scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Operational scripts for Attest8004 deployments on Monad (testnet round trip, gated execute)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "roundtrip": "node --conditions=@attest8004/source --env-file=../.env src/validation-roundtrip.ts",
    "gated-execute": "node --conditions=@attest8004/source --env-file=../.env src/gated-execute.ts",
    "hot-keys": "node src/hot-keys.ts",
    "addresses": "node --env-file=../.env src/addresses.ts",
    "setup-demo-agents": "node --conditions=@attest8004/source --env-file=../.env src/setup-demo-agents.ts",
    "set-passkey": "node --conditions=@attest8004/source --env-file=../.env src/set-passkey.ts",
    "submit-approval": "node --conditions=@attest8004/source --env-file=../.env src/submit-approval.ts",
    "e2e": "node --conditions=@attest8004/source --env-file=../.env src/e2e.ts",
    "indexer-check": "node --conditions=@attest8004/source --env-file=../.env src/indexer-check.ts",
    "indexer-keepalive": "node src/indexer-keepalive.ts",
    "cre-gas-probe": "node --conditions=@attest8004/source --env-file=../.env src/cre-gas-probe.ts"
  },
  "dependencies": {
    "@attest8004/sdk": "workspace:*",
    "@attest8004/validator-mandate": "workspace:*",
    "@attest8004/validator-risk": "workspace:*",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
