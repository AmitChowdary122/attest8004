#!/usr/bin/env sh
# Secret scan on every commit. Never bypass it (CLAUDE.md, hard rule 1).
# Enabled by `pnpm install` (root "prepare" script), or by hand:
#   git config core.hooksPath .githooks
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so the commit is blocked." >&2
  echo "Install it (https://github.com/gitleaks/gitleaks#installing) and retry." >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
