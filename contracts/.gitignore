# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv file
.env
.env.*
!.env.example
# Keep only run-latest.json per script and chain; timestamped copies and lock files are noise.
/broadcast/**/run-[0-9]*.json
/broadcast/**/*.lock
