{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "declaration": false,
    "noEmit": true,
    // @attest8004/sdk is imported as TypeScript source through its "@attest8004/source" export condition.
    "allowImportingTsExtensions": true,
    "customConditions": ["@attest8004/source"]
  },
  "include": ["src"]
}
