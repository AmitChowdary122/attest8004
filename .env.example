# Copy to .env and fill in. Never commit .env (gitleaks blocks it at pre-commit).
# Every key here is hackathon-only. Never reuse a personal wallet.
# Testnet MON: https://faucet.monad.xyz

# --- Chain ---------------------------------------------------------------
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_RPC_URL=https://rpc.monad.xyz
# 10143 = Monad testnet, 143 = Monad mainnet
CHAIN_ID=10143

# --- Canonical ERC-8004 registries (testnet; mainnet values in ARCHITECTURE.md 4.2)
IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713

# --- Wallets (secp256k1, hex private keys) --------------------------------
# Deploys contracts only; holds no admin rights afterwards.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Validator A: mandate-v1 (deterministic)
VALIDATOR_A_PRIVATE_KEY=
VALIDATOR_A_ADDRESS=
# Validator B: risk-v1 (agentic)
VALIDATOR_B_PRIVATE_KEY=
VALIDATOR_B_ADDRESS=
# Demo agents' hot keys: made by `pnpm --filter @attest8004/scripts hot-keys`, which writes them here
# and prints only the addresses. Registered with AgentRequestForwarder.setAgentKey; they can request
# validations for their own agent only, never move it. Fund each with MON for a few requests only.
DEMO_AGENT_1_HOT_PRIVATE_KEY=
DEMO_AGENT_1_HOT_ADDRESS=
DEMO_AGENT_2_HOT_PRIVATE_KEY=
DEMO_AGENT_2_HOT_ADDRESS=
# `pnpm demo`'s rogue key (P9, also made by hot-keys): scene 3 registers it as agent 1984's forwarder key outside the
# mandate (the Grok/Bankr replay) and scene 3b revokes it. Fund it for a few requests only (`pnpm demo --fund`).
DEMO_ROGUE_PRIVATE_KEY=
DEMO_ROGUE_ADDRESS=

# --- Attest8004 deployments (fill in after deploying; see docs/deployments.md)
VALIDATION_REGISTRY=
AGENT_REQUEST_FORWARDER=
MANDATE_REGISTRY=
DEMO_AGENT_VAULT=

# --- mandate-v1 validator service (pnpm --filter @attest8004/validator-mandate start) ---
# Signs with VALIDATOR_A_PRIVATE_KEY and reads MONAD_TESTNET_RPC_URL (above); contract addresses come
# from the SDK's DEPLOYMENTS. Run one process per validator key. Blank values use the defaults.
# The (gate, agent) pairs it answers for: comma-separated <gate address>:<agentId>. A listed gate named for
# any other agent is declined (GATE_NOT_FOR_AGENT), so nobody can spend this validator's gas by naming our
# gate for their own agent. Blank: the demo vault for agent 1984 (DEPLOYMENTS[10143].demoAgentVault:1984).
MANDATE_V1_GATES=
# Block cursor file, relative to the repo root (or absolute). Blank: validators/mandate/.state/cursor.json
MANDATE_V1_CURSOR=
# Admission policy (decimal integers): requests answered per agent per hour, and the validator's gas
# budget over 24 h; each admitted request reserves MANDATE_V1_MAX_RESPONSE_GAS, plus the operator report's cap
# (the SDK's OPERATOR_REPORT_GAS_CAP) once a FindingsBoard is deployed, until each is sent. The budget must cover both.
MANDATE_V1_MAX_REQUESTS_PER_AGENT_PER_HOUR=20
MANDATE_V1_DAILY_GAS_BUDGET=10000000
# Gas limit cap for one response: the estimate + 20%, capped here (Monad charges for the limit).
MANDATE_V1_MAX_RESPONSE_GAS=400000
# The service's RPC requests a second, 1-15 (the public RPC refuses more than 15 per IP). Blank: 7, so both
# validator services on one host stay under the limit together.
MANDATE_V1_RPC_REQUESTS_PER_SECOND=

# --- risk-v1's LLM --------------------------------------------------------
# Any OpenAI-compatible endpoint works; this is Groq's today. Prompt Guard (meta-llama/llama-prompt-guard-2-86m)
# is called on the same endpoint with the same key. Only the host is ever logged or recorded in evidence.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- risk-v1 validator service (pnpm --filter @attest8004/validator-risk start) -----------------
# Signs with VALIDATOR_B_PRIVATE_KEY, which must be DEPLOYMENTS[10143].validators.riskV1 (it refuses to start
# otherwise); reads MONAD_TESTNET_RPC_URL and the LLM_* settings above, and NANSEN_API_KEY below (optional:
# without it both Nansen tools answer "unavailable"). It answers a request only once mandate-v1 has answered
# the same action. Run one process per validator key. Blank values use the defaults.
# The (gate, agent) pairs it answers for, in MANDATE_V1_GATES' format: comma-separated <gate address>:<agentId>.
# Blank: the demo vault for agent 1984 (DEPLOYMENTS[10143].demoAgentVault:1984).
RISK_V1_GATES=
# Block cursor file, relative to the repo root (or absolute). Blank: validators/risk/.state/cursor.json
RISK_V1_CURSOR=
# Admission policy (decimal integers), as mandate-v1's: requests answered per agent per hour, and the
# validator's gas budget over 24 h; each admitted request reserves RISK_V1_MAX_RESPONSE_GAS, plus the operator
# report's cap once a FindingsBoard is deployed, until each is sent. The budget must cover both.
RISK_V1_MAX_REQUESTS_PER_AGENT_PER_HOUR=20
RISK_V1_DAILY_GAS_BUDGET=10000000
# Gas limit cap for one response: the estimate + 20%, capped here. risk-v1's evidence is larger than
# mandate-v1's (up to 24,576 bytes), so its cap is higher. Must not exceed RISK_V1_DAILY_GAS_BUDGET.
RISK_V1_MAX_RESPONSE_GAS=1000000
# The service's RPC requests a second, 1-15, as MANDATE_V1_RPC_REQUESTS_PER_SECOND. Blank: 7.
RISK_V1_RPC_REQUESTS_PER_SECOND=
# Client-side pacing for the main model, below the provider's limits (Groq free tier for gpt-oss-120b:
# 30 requests and 8,000 tokens a minute). At least 7000 tokens: the largest request risk-v1 sends.
# Prompt Guard has its own fixed pacer (30 requests, 15,000 tokens a minute).
RISK_V1_LLM_REQUESTS_PER_MINUTE=30
RISK_V1_LLM_TOKENS_PER_MINUTE=8000

# --- Nansen ---------------------------------------------------------------
NANSEN_API_KEY=
# Fallback: x402 pay-per-call (USDC). Use a separate, minimally funded wallet.
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
X402_PAYER_PRIVATE_KEY=

# --- Envio HyperIndex -----------------------------------------------------
# A HyperSync API token (free: envio.dev/app/api-tokens), needed only to run the indexer locally
# (`pnpm --filter @attest8004/indexer dev`, which reads this one line and never prints it). Envio Cloud doesn't need it.
ENVIO_API_TOKEN=
# Optional: the GraphQL endpoint indexer-check uses when no --url is given and DEPLOYMENTS records no trust API
# (e.g. a local indexer at http://localhost:8080/v1/graphql). The pages never read it.
ENVIO_GRAPHQL_URL=
# --- Chainlink CRE, validator C (P11; docs/cre.md) --------------------------
# The ONLY key that broadcasts CRE reports (`cre workflow simulate --broadcast`, run by `pnpm cre:demo`). Hackathon-only,
# funded with a little testnet MON; the demo passes it to the CRE CLI through the CLI's environment and nothing else.
# 0x-prefixed or not; never committed.
CRE_ETH_PRIVATE_KEY=
CRE_BROADCAST_ADDRESS=
# The read-only mandate-v1 /evaluate service (pnpm --filter @attest8004/validator-mandate evaluate; pnpm cre:demo runs
# one in-process). It holds no key, listens on 127.0.0.1 only and answers for MANDATE_V1_GATES (above).
# Blank: port 8787 (what cre/validator-c/config.monad-testnet.json names) and 7 RPC requests a second.
CRE_EVALUATE_PORT=
CRE_EVALUATE_RPC_REQUESTS_PER_SECOND=
