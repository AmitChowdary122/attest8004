{
  "name": "attest8004",
  "private": true,
  "description": "The ERC-8004 Validation layer for Monad",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:contracts": "cd contracts && forge test",
    "attest8004": "node --conditions=@attest8004/source --env-file-if-exists=.env packages/cli/bin/attest8004.mjs",
    "demo": "node --conditions=@attest8004/source --env-file=.env scripts/src/demo.ts",
    "cre:demo": "node --conditions=@attest8004/source --env-file=.env scripts/src/cre-demo.ts"
  }
}
